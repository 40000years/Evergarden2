<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.example</groupId>
        <artifactId>evergarden2-parent</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>evergarden</artifactId>
    <packaging>jar</packaging>
    <repositories>
        <repository><id>lumine</id><url>https://mvn.lumine.io/repository/maven-public/</url></repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>com.ticxo.modelengine</groupId><artifactId>ModelEngine</artifactId>
            <version>R4.1.1</version><scope>provided</scope>
        </dependency>
        <!-- Advance Magic API -->
        <dependency>
            <groupId>com.example</groupId>
            <artifactId>advance-magic</artifactId>
            <version>1.0.0</version>
            <scope>provided</scope>
        </dependency>
        <!-- Floodgate API -->
        <dependency>
            <groupId>org.geysermc.floodgate</groupId>
            <artifactId>api</artifactId>
            <version>2.2.5-SNAPSHOT</version>
            <scope>provided</scope>
            <exclusions>
                <exclusion>
                    <groupId>com.google.code.gson</groupId>
                    <artifactId>gson</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>

    <build>
        <finalName>evergarden</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>**/*.bak</exclude>
                </excludes>
            </resource>
            <resource>
                <directory>dist</directory>
                <targetPath>resource-packs</targetPath>
                <filtering>false</filtering>
                <includes>
                    <include>evergarden-java.zip</include>
                    <include>judge-java.zip</include>
                    <include>evergarden-bedrock.mcpack</include>
                    <include>geyser-mappings.json</include>
                    <include>pack-hashes.json</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <!-- Compile the shared delivery package into both JARs. Evergarden's
                 resource packs must also work without the optional Magic plugin. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <execution>
                        <id>shared-pack-delivery</id>
                        <phase>generate-sources</phase>
                        <goals><goal>add-source</goal></goals>
                        <configuration>
                            <sources><source>${project.basedir}/../advance-magic/src/main/java/com/example/advancemagic/pack/delivery</source></sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
