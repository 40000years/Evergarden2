        "default": "entity_alphatest",
        "glow": "entity_emissive_alpha"
      },
      "textures": {
        "default": "textures/elemental_staffs/materials"
      },
      "geometry": {
        "default": "geometry.advance_magic.staff_lightning",
        "fx": "geometry.advance_magic.staff_lightning_fx"
      },
      "animations": {
        "first": "animation.advance_magic.staff_lightning.first",
        "third": "animation.advance_magic.staff_lightning.third",
        "idle": "animation.advance_magic.staff_lightning.idle"
      },
      "scripts": {
        "animate": [
          {
            "first": "context.is_first_person == 1.0"
          },
          {
            "third": "context.is_first_person == 0.0"
          },
          "idle"
        ]
      },
      "render_controllers": [
        "controller.render.advance_magic.elemental_staff_body",
        "controller.render.advance_magic.staff_lightning_fx"
      ]
    }
